programa {
  funcao inicio() {
  //entedimento do problema
  //calcular o numeros de laranja vendidas
  //infos e variaveis
  inteiro laranja , laranja2 , larafim
  //entrada de dados
  escreva("quantas laranjas vc tinha no inicio: ")
  leia(laranja)
  escreva("quantas laranjas sobraram:")
  leia(laranja2)
  //procesamento
larafim = laranja - laranja2
  //saida
  escreva("o numero total de laranjas vendidas foi de : ")
  escreva(larafim)
  }
}
