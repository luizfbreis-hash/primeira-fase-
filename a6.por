programa {
  funcao inicio() {
    //entendimento do problema 
    //calcular o quanto junin ganha no dia
   //infos e variaveis
   inteiro dia
   real salario,salarioDoDIa
   //entrada de dados 
   escreva("quanto vc ganha por mes: ")
   leia(salario)
   escreva("quantos dias vc trabalhou ")
   leia(dia)
   //processo
   salarioDoDIa = salario - dia
   //saida

  }
}
