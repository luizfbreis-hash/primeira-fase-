programa {
  funcao inicio() {
  //entendimento do problema
  //criar uma calculadora
  //infos e variaves
  real carne, cerveja, agua, refri
  inteiro pessoas
  //entrada de dados
  escreva("qual e a quantidade de pessoas que vc  convidou: ")
  leia(pessoas)

  // processamento
  carne= pessoas*0.5
  cerveja=pessoas*1
  agua=pessoas* 0.5
  refri=pessoas* 0.2
  //saida
  escreva("carne:"+carne)
  escreva("\ncerveja:"+cerveja)
  escreva("\naguá::"+refri)

  }
}
