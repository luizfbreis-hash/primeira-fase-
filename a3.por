programa {
  funcao inicio() {
    // entedimento do problema
    //calcular o numero de devs 
    //infos e variaveis
    inteiro clts, pj, estagiarios ,devs
    //entrada de dados
    escreva("qual e o numero de clts: ")
    leia(clts)
    escreva("qual e o numero de pj: ")
    leia(pj)
    escreva("qual e o numero de estagiarios:")
    leia(estagiarios)
    //procesamento
    devs = clts + pj + estagiarios
    //saida
    escreva("o numero de desenvolvedores da sua empresa é: ")
    escreva(devs)
  }
}
